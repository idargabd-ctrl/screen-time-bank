# Пароли и токены
.env

# Данные контейнеров: конфиг Home Assistant, сессия Google, база
data/

# Снимки настроек Family Link (могут содержать имена и id устройств)
snapshots/

# Питон
__pycache__/
*.pyc
.venv/
venv/

# База приложения. Владелец — обычный пользователь, поэтому не в data/:
# тот каталог создан Docker от root, и хостовые скрипты в него не пишут.
/appdata/

# Видеофайлы уроков: раздаются с сервера, в репозиторий не попадают
/media/

# Локальные настройки Claude Code: разрешения и адреса этой машины
.claude/settings.local.json
