# Скопируйте этот файл в .env и заполните.
# Файл .env содержит пароли и в git не попадает.

# --- Часовой пояс -----------------------------------------------------------
# Определяет, в какой момент наступает "новый день" и обнуляется квота.
# Должен совпадать с часовым поясом Google-аккаунта ребёнка.
TZ=Europe/Moscow

# --- Сервис входа в Google --------------------------------------------------
# Пароль от окна браузера, в котором вы один раз войдёте в Google (этап 1).
# Придумайте любой, запишите. Пример: sinij-slon-42
VNC_PASSWORD=

# Ключ, которым закрыт доступ к сохранённой сессии Google.
# Придумайте длинную случайную строку, минимум 30 символов.
FL_AUTH_API_KEY=

# --- Приложение -------------------------------------------------------------
# Имя ребёнка, как его показывает сайт. Читается один раз, при создании базы.
CHILD_NAME=Ученик

# Подписывает куку входа. Длинная случайная строка. Смена значения разлогинит
# всех — это нормально, но не должно происходить само.
APP_SECRET=

# --- Home Assistant ---------------------------------------------------------
# Заполняется на шаге 5 этапа 1, когда создадите токен в интерфейсе HA.
HA_URL=http://127.0.0.1:8123
HA_TOKEN=

# --- Кого и что мы контролируем ---------------------------------------------
# Заполняется на шаге 6 после команды: python tools/fl.py discover
FL_CHILD_ID=
FL_TABLET_DEVICE_ID=
FL_PHONE_DEVICE_ID=
